#!/usr/bin/env bash
set -euo pipefail

USAGE='usage: agentboard-manager {codex|grok|codewhale|claude}'
usage() {
  echo "$USAGE" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage
if [[ $1 == -h || $1 == --help ]]; then
  cat <<EOF
$USAGE

Start the manager seat as the board actor "manager" (AGENTBOARD_ACTOR=manager; the
client reads the global agentboard MCP entry that install.py registers). Inside herdr (HERDR_ENV=1)
it renames this tab to "manager" and starts the client in this pane; inside hc
(any HC_* variable, with HC_TERMINAL_ID) it starts the client in this terminal.
Codewhale is hc only.
EOF
  exit 0
fi
KIND=$1
case "$KIND" in
  claude|codex|grok|codewhale) ;;
  *) usage ;;
esac

# HERDR_ENV=1 means herdr: rename the tab and start in this pane. Else any HC_*
# variable means hc: start a new terminal. Else refuse. herdr wins when both are
# present, as in the manual.
if [[ ${HERDR_ENV:-} == 1 ]]; then
  if [[ $KIND == codewhale ]]; then
    echo 'agentboard-manager: herdr has no codewhale agent kind; run codewhale under hc' >&2
    exit 1
  fi
  world=herdr needs=(herdr jq setsid)
  [[ -n ${HERDR_PANE_ID:-} && -n ${HERDR_TAB_ID:-} ]] || {
    echo 'agentboard-manager: HERDR_PANE_ID and HERDR_TAB_ID are required inside herdr' >&2
    exit 1
  }
elif [[ -n $(compgen -e HC_) ]]; then
  world=hc needs=(hc jq setsid)
  [[ -n ${HC_TERMINAL_ID:-} ]] || {
    echo 'agentboard-manager: HC_TERMINAL_ID is required inside hc (the manager runs in this terminal)' >&2
    exit 1
  }
else
  echo 'agentboard-manager: run it inside herdr (HERDR_ENV=1) or hc (any HC_* variable set)' >&2
  exit 1
fi
for command in "${needs[@]}"; do
  command -v "$command" >/dev/null 2>&1 || { echo "agentboard-manager: required command not found: $command" >&2; exit 1; }
done

case "$KIND" in
  claude)
    argv=(env -u CODEX_HOME -u CLAUDE_CONFIG_DIR -u GROK_HOME -u CODEWHALE_HOME AGENTBOARD_ACTOR=manager claude --model claude-sonnet-5-5 --dangerously-skip-permissions /agentboard-manager)
    hargs=(--model claude-sonnet-5-5 --dangerously-skip-permissions -- /agentboard-manager)
    ;;
  codex)
    argv=(env -u CODEX_HOME -u CLAUDE_CONFIG_DIR -u GROK_HOME -u CODEWHALE_HOME AGENTBOARD_ACTOR=manager codex --no-daemon --model gpt-6-sol -c model_reasoning_effort=medium --dangerously-bypass-approvals-and-sandbox '$agentboard-manager')
    hargs=(--model gpt-6-sol -c model_reasoning_effort=medium --dangerously-bypass-approvals-and-sandbox -- '$agentboard-manager')
    ;;
  grok)
    argv=(env -u CODEX_HOME -u CLAUDE_CONFIG_DIR -u GROK_HOME -u CODEWHALE_HOME AGENTBOARD_ACTOR=manager grok --trust --always-approve)
    hargs=(--trust --always-approve)
    ;;
  codewhale)
    argv=(env -u CODEX_HOME -u CLAUDE_CONFIG_DIR -u GROK_HOME -u CODEWHALE_HOME AGENTBOARD_ACTOR=manager codewhale --skip-onboarding --fresh --disable subagents --approval-policy never)
    ;;
esac

log=${XDG_RUNTIME_DIR:-/tmp}/agentboard-manager-start.log
if [[ $world == herdr ]]; then
  herdr tab rename "$HERDR_TAB_ID" manager
  # the board actor rides in the environment herdr gives the agent
  export AGENTBOARD_ACTOR=manager
  unset CODEX_HOME CLAUDE_CONFIG_DIR GROK_HOME CODEWHALE_HOME
  setsid bash -c '
    pane=$1 kind=$2
    shift 2
    for _ in {1..50}; do
      if herdr pane process-info --pane "$pane" | jq -e ".result.process_info // {} | (.shell_pid != null and .foreground_process_group_id != null and .foreground_process_group_id == .shell_pid)" >/dev/null; then
        herdr agent start manager --kind "$kind" --pane "$pane" -- "$@"
        if [[ $kind == grok ]]; then
          herdr agent prompt manager /agentboard-manager --wait
        fi
        exit
      fi
      sleep 0.2
    done
    echo "timed out waiting for shell prompt in pane $pane" >&2
    exit 1
  ' _ "$HERDR_PANE_ID" "$KIND" "${hargs[@]}" >>"$log" 2>&1 </dev/null &
else
  # hc: the manager replaces this shell in this terminal. Grok and Codewhale cannot
  # take the entry prompt in argv, so a detached helper types it here once the client
  # has settled, retrying while hc answers "still starting"; failures go to $log.
  if [[ $KIND == grok || $KIND == codewhale ]]; then
    setsid bash -c '
      term=$1 sent=
      sleep 1
      hc wait "$term" --timeout 30 >/dev/null || true
      for _ in {1..10}; do
        status=0
        sent=$(hc send --wait "$term" /agentboard-manager 2>&1) || status=$?
        if [[ $status -eq 0 ]] && jq -e ".started == true" >/dev/null 2>&1 <<<"$sent"; then exit 0; fi
        [[ $status -eq 0 ]] && break
        [[ $sent == *"still starting"* ]] || break
        sleep 1
      done
      printf "%s\n" "$sent"
      echo "entry prompt did not land in $term; type /agentboard-manager there"
      exit 1
    ' _ "$HC_TERMINAL_ID" >>"$log" 2>&1 </dev/null &
  fi
  exec "${argv[@]}"
fi
