{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permission": {
    "bash": {
      "*": "allow",
      "*grep *": "deny",
      "*grep": "deny"
    }
  },
  "provider": {
    "openai": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/openai/v1"
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/anthropic/v1"
      }
    },
    "opencode-go": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/compat/opencode-go/v1"
      }
    }
  },
  "mcp": {
    "caveman": {
      "type": "local",
      "command": [
        "caveman-mcp"
      ],
      "enabled": true
    },
    "servers": {
      "agentboard": {
        "type": "local",
        "command": [
          "agentboard"
        ],
        "environment": {
          "AGENTBOARD_ACTOR": "opencode"
        }
      },
      "git-mcp-rs": {
        "type": "local",
        "command": [
          "git-mcp-rs"
        ]
      },
      "ferris-search": {
        "type": "local",
        "command": [
          "ferris-search"
        ]
      },
      "codebase-memory-mcp": {
        "type": "local",
        "command": [
          "codebase-memory-mcp"
        ]
      }
    }
  },
  "plugin": [
    "./plugins/caveman"
  ]
}
