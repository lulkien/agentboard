#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'usage: start-agentboard-manager {claude|codex|grok}' >&2
  exit 1
}

[[ $# -eq 1 ]] || usage
KIND=$1
case "$KIND" in
  claude|codex|grok) ;;
  *) usage ;;
esac

# HERDR_ENV=1 means herdr: rename the tab and start in this pane. Else any HC_*
# variable means hc: start a new terminal. Else refuse. herdr wins when both are
# present, as in the manual.
if [[ ${HERDR_ENV:-} == 1 ]]; then
  world=herdr needs=(herdr jq setsid)
  [[ -n ${HERDR_PANE_ID:-} && -n ${HERDR_TAB_ID:-} ]] || {
    echo 'start-agentboard-manager: HERDR_PANE_ID and HERDR_TAB_ID are required inside herdr' >&2
    exit 1
  }
elif [[ -n $(compgen -e HC_) ]]; then
  world=hc needs=(hc jq)
else
  echo 'start-agentboard-manager: run it inside herdr (HERDR_ENV=1) or hc (any HC_* variable set)' >&2
  exit 1
fi
for command in "${needs[@]}"; do
  command -v "$command" >/dev/null 2>&1 || { echo "start-agentboard-manager: required command not found: $command" >&2; exit 1; }
done

case "$KIND" in
  claude)
    argv=(claude --model claude-sonnet-5-5 --mcp-config "$HOME/.claude/manager-mcp.json" --dangerously-skip-permissions /agentboard-manager)
    hargs=(--model claude-sonnet-5-5 --mcp-config "$HOME/.claude/manager-mcp.json" --dangerously-skip-permissions -- /agentboard-manager)
    ;;
  codex)
    argv=(codex --no-daemon --profile manager '$agentboard-manager')
    hargs=(--profile manager -- '$agentboard-manager')
    ;;
  grok)
    argv=(grok --trust --always-approve)
    hargs=(--trust --always-approve)
    ;;
esac

log=${XDG_RUNTIME_DIR:-/tmp}/agentboard-manager-start.log
if [[ $world == herdr ]]; then
  herdr tab rename "$HERDR_TAB_ID" manager
  setsid bash -c '
    pane=$1 kind=$2
    shift 2
    for _ in {1..50}; do
      if herdr pane process-info --pane "$pane" | jq -e ".result.process_info // {} | (.shell_pid != null and .foreground_process_group_id != null and .foreground_process_group_id == .shell_pid)" >/dev/null; then
        herdr agent start manager --kind "$kind" --pane "$pane" -- "$@"
        if [[ $kind == grok ]]; then
          herdr agent prompt manager /agentboard-manager --wait
        fi
        exit
      fi
      sleep 0.2
    done
    echo "timed out waiting for shell prompt in pane $pane" >&2
    exit 1
  ' _ "$HERDR_PANE_ID" "$KIND" "${hargs[@]}" >>"$log" 2>&1 </dev/null &
else
  reply=$(hc run --json --bg --outlive-parent --name manager --cwd "$PWD" -- "${argv[@]}")
  addr=$(jq -r '.address // empty' <<<"$reply")
  if [[ -z $addr ]]; then
    printf 'start-agentboard-manager: hc run reported no address: %s\n' "$reply" >&2
    exit 1
  fi

  if [[ $KIND == grok ]]; then
    hc wait manager >/dev/null
    status=0
    sent=$(hc send --wait manager /agentboard-manager) || status=$?
    if [[ $status -ne 0 ]] || ! jq -e '.started == true' >/dev/null 2>&1 <<<"$sent"; then
      printf '%s\n' "${sent:-}" >>"$log"
      echo "start-agentboard-manager: the entry prompt did not land; read the terminal: hc read --lines 40 manager" >&2
      exit 1
    fi
  fi

  echo "manager $addr"
fi
