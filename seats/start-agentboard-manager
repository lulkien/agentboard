#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'usage: start-agentboard-manager {claude|codex|grok|codewhale}' >&2
  exit 1
}

[[ $# -eq 1 ]] || usage
KIND=$1
case "$KIND" in
  claude|codex|grok|codewhale) ;;
  *) usage ;;
esac

# HERDR_ENV=1 means herdr: rename the tab and start in this pane. Else any HC_*
# variable means hc: start a new terminal. Else refuse. herdr wins when both are
# present, as in the manual.
if [[ ${HERDR_ENV:-} == 1 ]]; then
  if [[ $KIND == codewhale ]]; then
    echo 'start-agentboard-manager: herdr has no codewhale agent kind; run codewhale under hc' >&2
    exit 1
  fi
  world=herdr needs=(herdr jq setsid)
  [[ -n ${HERDR_PANE_ID:-} && -n ${HERDR_TAB_ID:-} ]] || {
    echo 'start-agentboard-manager: HERDR_PANE_ID and HERDR_TAB_ID are required inside herdr' >&2
    exit 1
  }
elif [[ -n $(compgen -e HC_) ]]; then
  world=hc needs=(hc jq)
else
  echo 'start-agentboard-manager: run it inside herdr (HERDR_ENV=1) or hc (any HC_* variable set)' >&2
  exit 1
fi
for command in "${needs[@]}"; do
  command -v "$command" >/dev/null 2>&1 || { echo "start-agentboard-manager: required command not found: $command" >&2; exit 1; }
done

claude_home="$HOME/.local/share/agentboard/seats/manager/claude"
claude_mcp="$claude_home/mcp.json"
if [[ $KIND == claude && ( ! -f $claude_home/.agentboard-seat || ! -f $claude_mcp ) ]]; then
  echo "start-agentboard-manager: $claude_home is missing; run seats/install.py and skills/install.py" >&2
  exit 1
fi

cwhome="$HOME/.local/share/agentboard/seats/manager/codewhale"
if [[ $KIND == codewhale && ! -f $cwhome/config.toml ]]; then
  echo "start-agentboard-manager: $cwhome/config.toml missing; run seats/install.py" >&2
  exit 1
fi

codex_home="$HOME/.local/share/agentboard/seats/manager/codex"
if [[ $KIND == codex && ! -f $codex_home/manager.config.toml ]]; then
  echo "start-agentboard-manager: $codex_home/manager.config.toml missing; run seats/install.py" >&2
  exit 1
fi

case "$KIND" in
  claude)
    argv=(env "CLAUDE_CONFIG_DIR=$claude_home" claude --model claude-sonnet-5-5 --mcp-config "$claude_mcp" --strict-mcp-config --dangerously-skip-permissions /agentboard-manager)
    hargs=(--model claude-sonnet-5-5 --mcp-config "$claude_mcp" --strict-mcp-config --dangerously-skip-permissions -- /agentboard-manager)
    ;;
  codex)
    argv=(env "CODEX_HOME=$codex_home" codex --no-daemon --profile manager '$agentboard-manager')
    hargs=(--profile manager -- '$agentboard-manager')
    ;;
  grok)
    argv=(grok --trust --always-approve)
    hargs=(--trust --always-approve)
    ;;
  codewhale)
    # hc run forwards no environment, so the seat home goes in through env(1)
    argv=(env "CODEWHALE_HOME=$cwhome" codewhale --skip-onboarding --fresh --disable subagents)
    ;;
esac

log=${XDG_RUNTIME_DIR:-/tmp}/agentboard-manager-start.log
if [[ $world == herdr ]]; then
  herdr tab rename "$HERDR_TAB_ID" manager
  if [[ $KIND == codex ]]; then export CODEX_HOME="$codex_home"; fi
  if [[ $KIND == claude ]]; then export CLAUDE_CONFIG_DIR="$claude_home"; fi
  setsid bash -c '
    pane=$1 kind=$2
    shift 2
    for _ in {1..50}; do
      if herdr pane process-info --pane "$pane" | jq -e ".result.process_info // {} | (.shell_pid != null and .foreground_process_group_id != null and .foreground_process_group_id == .shell_pid)" >/dev/null; then
        herdr agent start manager --kind "$kind" --pane "$pane" -- "$@"
        if [[ $kind == grok ]]; then
          herdr agent prompt manager /agentboard-manager --wait
        fi
        exit
      fi
      sleep 0.2
    done
    echo "timed out waiting for shell prompt in pane $pane" >&2
    exit 1
  ' _ "$HERDR_PANE_ID" "$KIND" "${hargs[@]}" >>"$log" 2>&1 </dev/null &
else
  reply=$(hc run --json --bg --outlive-parent --name manager --cwd "$PWD" -- "${argv[@]}")
  addr=$(jq -r '.address // empty' <<<"$reply")
  if [[ -z $addr ]]; then
    printf 'start-agentboard-manager: hc run reported no address: %s\n' "$reply" >&2
    exit 1
  fi

  if [[ $KIND == grok ]]; then
    hc wait manager >/dev/null
    status=0
    sent=$(hc send --wait manager /agentboard-manager) || status=$?
    if [[ $status -ne 0 ]] || ! jq -e '.started == true' >/dev/null 2>&1 <<<"$sent"; then
      printf '%s\n' "${sent:-}" >>"$log"
      echo "start-agentboard-manager: the entry prompt did not land; read the terminal: hc read --lines 40 manager" >&2
      exit 1
    fi
  fi

  if [[ $KIND == codewhale ]]; then
    # the seat's hooks report status (seats/codewhale/status-hooks.toml): wait for it,
    # then send until hc stops answering "still starting"
    hc wait manager --timeout 30 >/dev/null
    landed=0
    for _ in {1..10}; do
      status=0
      sent=$(hc send --wait manager /agentboard-manager 2>&1) || status=$?
      if [[ $status -eq 0 ]] && jq -e '.started == true' >/dev/null 2>&1 <<<"$sent"; then landed=1; break; fi
      [[ $status -eq 0 ]] && break
      [[ $sent == *'still starting'* ]] || break
      sleep 1
    done
    if [[ $landed -ne 1 ]]; then
      printf '%s\n' "${sent:-}" >>"$log"
      echo "start-agentboard-manager: the entry prompt did not land; read the terminal: hc read --lines 40 manager" >&2
      exit 1
    fi
  fi

  echo "manager $addr"
fi
