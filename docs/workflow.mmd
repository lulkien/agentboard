flowchart TD
  subgraph MGR["Manager - Hermes"]
    A["Create EPIC task"]
    B["Create implement task, parent = EPIC"]
    P["Poll board: get, brief, children"]
    C["Create review task, parent = EPIC"]
    D["Delegate fix task to fixer"]
    V["Delegate verify task to checker"]
    Z["Set review task done, then EPIC done"]
  end

  subgraph IMP["Implementer - Claude"]
    I1["Claim task, implement, notes"]
    I2["task_update: report + status review"]
  end

  subgraph REV["Reviewer - Claude or opencode (reviews and re-checks)"]
    R0["Claim review task, read diff"]
    R1{"Changes needed?"}
    RD["Set review task done with evidence"]
    RF["task_add fix task, parent = review task"]
    RN["Set review task status needs_fix"]
    X1["Re-check the fix against own findings"]
    X2{"All checks PASS?"}
  end

  subgraph FIX["Fixer - Claude"]
    F1["Claim fix task, fix listed findings"]
    F2["Fix task done, verdict per finding"]
  end

  A --> B --> I1
  I1 --> I2
  I2 --> P
  P --> C
  C --> R0
  R0 --> R1
  R1 -- no --> RD
  R1 -- yes --> RF
  RF --> RN
  RN --> P
  P --> D
  D --> F1
  F1 --> F2
  F2 --> V
  V --> X1
  X1 --> X2
  X2 -- yes --> Z
  X2 -- no --> D
  RD --> Z
  Z --> E(["Workflow complete, board empty"])
